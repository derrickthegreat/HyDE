${cacheDir}/wallbash/dunst.conf|${WALLBASH_SCRIPTS}/dunst.sh

[urgency_low]
    background = "#<wallbash_3xa5>80"
    foreground = "#<wallbash_3xa9>E6"
    frame_color = "#<wallbash_3xa5>03"
    highlight = "#<wallbash_3xa6>"
    icon = "${iconsDir}/Wallbash-Icon/hyprdots.svg"
    timeout = 5

[urgency_normal]
    background = "#<wallbash_2xa2>80"
    foreground = "#<wallbash_2xa9>E6"
    frame_color = "#<wallbash_2xa2>03"
    highlight = "#<wallbash_2xa6>"
    icon = "${iconsDir}/Wallbash-Icon/hyprdots.svg"
    timeout = 5

# Inverts the normal scheme so critical notifications stand out; the red frame stays fixed
[urgency_critical]
    background = "#<wallbash_1xa8>E6"
    foreground = "#<wallbash_1xa1>"
    frame_color = "#f38ba8"
    highlight = "#<wallbash_1xa4>"
