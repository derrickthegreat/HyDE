{
  "network": {
    "tooltip": true,
    "format-wifi": "\uf1eb ",
    "rotate": 0,
    "format-ethernet": "\udb80\ude00 ",
    "tooltip-format": "Interface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>",
    "tooltip-format-wifi": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
    "tooltip-format-ethernet": "Ethernet: <big><b>{ifname}</b></big>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>",
    "tooltip-format-linked": "Interface: <b>{ifname}</b>\nConnected, no IP address",
    "format-linked": "\udb80\ude00 {ifname} (No IP)",
    "format-disconnected": "\udb81\uddaa ",
    "tooltip-format-disconnected": "Disconnected",
    "format-alt": "\uf019 {bandwidthDownBytes} \uf093 {bandwidthUpBytes}",
    "interval": 2
  }
}
